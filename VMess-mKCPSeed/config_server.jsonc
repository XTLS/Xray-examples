{
    "log": {
        "loglevel": "warning"
    },
    "inbounds": [
        {
            "protocol": "vmess",
            "port": 1234,
            "settings": {
                "clients": [
                    {
                        "id": "" //填写你的 UUID
                    }
                ]
            },
            "streamSettings": {
                "network": "kcp",
                "finalmask": {
                    "udp": [
                        {
                            "type": "mkcp-legacy",
                            "settings": {
                                "value": "my-seed" // 任意字符串，服务端客户端需要一致
                            }
                        }
                    ]
                }
            }
        }
    ],
    "outbounds": [
        {"protocol": "freedom"}
    ]
}
