{
    "log": {
        "loglevel": "warning"
    },
    "inbounds": [
        {
            "port": 1080,
            "listen": "127.0.0.1",
            "protocol": "socks",
            "settings": {
                "udp": true
            }
        }
    ],
    "outbounds": [
        {
            "protocol": "vless",
            "settings": {
                "address": "{{ host }}",
                "port": 1234,
                "id": "", //填写你的 UUID
                "encryption": "none"
            },
            "streamSettings": {
                "network": "kcp",
                "finalmask": {
                    "udp": [
                        {
                            "type": "mkcp-legacy",
                            "settings": {
                                "value": "my-seed" // 任意字符串，服务端客户端需要一致
                            }
                        }
                    ]
                }
            }
        }
    ]
}